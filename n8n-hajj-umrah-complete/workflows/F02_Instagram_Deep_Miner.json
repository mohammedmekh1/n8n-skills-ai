      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [450, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.apify.com/v2/acts/apify~instagram-scraper/runs",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "hashtag",
              "value": "={{ $json.hashtag }}"
            },
            {
              "name": "resultsLimit",
              "value": "100"
            },
            {
              "name": "includeComments",
              "value": "true"
            }
          ]
        },
        "options": {}
      },
      "id": "apify-instagram",
      "name": "Apify Instagram Deep",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [650, 300]
    },
    {
      "parameters": {
        "model": "gpt-4o-mini",
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "Analyze Instagram posts and comments for Hajj/Umrah proxy intent. Look for emotional indicators: grief, illness, disability, religious duty. Score 1-100 based on urgency and authenticity. Output JSON: { \"post_id\": string, \"author\": string, \"intent_score\": number, \"emotion\": \"grief\"|\"hope\"|\"duty\"|\"confusion\", \"category\": \"deceased\"|\"sick\"|\"disabled\", \"language\": string, \"action_required\": boolean }."
            },
            {
              "role": "user",
              "content": "Post: {{ $json.caption }}\nComments: {{ $json.comments }}"
            }
          ]
        },
        "options": {}
      },
      "id": "ai-deep-analysis",
      "name": "AI Deep Analysis",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1,
      "position": [850, 300]
    },
    {
      "parameters": {
        "functionCode": "const items = $input.all();\nconst highPriority = items.filter(item => item.json.intent_score >= 70);\nreturn highPriority;"
      },
      "id": "filter-high-score",
      "name": "Filter High Score",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [1050, 300]
    },
    {
      "parameters": {
        "operation": "append",
        "sheetId": "YOUR_GOOGLE_SHEET_ID",
        "range": "DeepLeads!A:H",
        "options": {}
      },
      "id": "save-deep-leads",
      "name": "Save Deep Leads",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 3,
      "position": [1250, 300]
    }
