{
  "name": "F1_Global_Radar_Capture",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "hajj-radar-trigger",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "trigger-node",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.apify.com/v2/acts/apify~instagram-scraper/runs",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "hashtag",
              "value": "={{ $json.hashtag }}"
            },
            {
              "name": "resultsLimit",
              "value": "50"
            }
          ]
        },
        "options": {}
      },
      "id": "apify-scraper",
      "name": "Apify Instagram Scraper",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [450, 300]
    },
    {
      "parameters": {
        "functionCode": "const items = $input.all();\nconst keywords = ['حج بدل', 'عمرة عن متوفي', 'نيابة حج', 'Hajj proxy', 'Umrah for deceased'];\nconst filtered = items.filter(item => {\n  const text = item.json.caption || item.json.text || '';\n  return keywords.some(k => text.toLowerCase().includes(k.toLowerCase()));\n});\nreturn filtered;"
      },
      "id": "filter-intent",
      "name": "Filter Intent AI",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [650, 300]
    },
    {
      "parameters": {
        "model": "gpt-4o-mini",
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You are a Sharia-compliant intent analyzer for Hajj/Umrah proxy services. Analyze the post and determine if it indicates a genuine need for proxy services (deceased, sick, disabled). Output JSON: { \"is_lead\": boolean, \"score\": number, \"reason\": string, \"category\": \"deceased\"|\"sick\"|\"disabled\"|\"general\" }."
            },
            {
              "role": "user",
              "content": "={{ $json.caption }}"
            }
          ]
        },
        "options": {}
      },
      "id": "ai-analyzer",
      "name": "AI Intent Analyzer",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1,
      "position": [850, 300]
    },
    {
      "parameters": {
        "operation": "append",
        "sheetId": "YOUR_GOOGLE_SHEET_ID",
        "range": "Leads!A:E",
        "options": {}
      },
      "id": "google-sheets",
      "name": "Save to Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 3,
      "position": [1050, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.telegram.org/bot{{TELEGRAM_BOT_TOKEN}}/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"chat_id\": \"{{TELEGRAM_CHAT_ID}}\",\n  \"text\": \"🔥 Lead Found:\\nCategory: {{ $json.category }}\\nScore: {{ $json.score }}\\nPost: {{ $json.caption }}\"\n}",
        "options": {}
      },
      "id": "telegram-notify",
      "name": "Telegram Notification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [1250, 300]
    }
  ],
