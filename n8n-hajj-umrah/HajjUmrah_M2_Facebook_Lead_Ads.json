          }
        ]
      ]
    },
    "Facebook Lead Ads - Fetch Leads": {
      "main": [
        [
          {
            "node": "Split In Batches",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Split In Batches": {
      "main": [
        [
          {
            "node": "Process Lead Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Process Lead Data": {
      "main": [
        [
          {
            "node": "Google Sheets - Save Lead",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Google Sheets - Save Lead": {
      "main": [
        [
          {
            "node": "Telegram - Notify Sales Team",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Telegram - Notify Sales Team": {
      "main": [
        [
          {
            "node": "WhatsApp - Send Welcome",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "WhatsApp - Send Welcome": {
      "main": [
        [
          {
            "node": "Facebook - Update Lead Status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Facebook - Update Lead Status": {
      "main": [
        [
          {
            "node": "Split In Batches",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
