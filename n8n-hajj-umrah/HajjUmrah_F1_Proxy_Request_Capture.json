      "id": "hu-code-001",
      "name": "Code – Normalize Proxy Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 100],
      "parameters": {
        "jsCode": "\n// HajjUmrah – F1 – Proxy Request Normalizer\nconst raw = $input.first()?.json || {};\nconst d = raw.body || raw;\n\n// تحديد نوع الطلب\nconst requestType = d.request_type || 'umrah_deceased';\nconst isHajj = requestType.includes('hajj');\nconst category = requestType.split('_')[1]; // deceased, patient, disabled\n\n// استخراج بيانات مقدم الطلب\nconst requesterPhone = (d.requester_phone || d.phone || '').replace(/[^\\d+]/g,'');\nconst requesterName = d.requester_name || d.contact_name || 'مقدم الطلب';\nconst requesterRelation = d.requester_relation || '';\nconst requesterEmail = d.requester_email || d.email || '';\nconst requesterId = d.requester_id_number || d.national_id || '';\n\n// استخراج بيانات المتوفي/المريض/العاجز\nconst beneficiaryName = d.deceased_name || d.patient_name || d.beneficiary_name || '';\nconst beneficiaryNationality = d.deceased_nationality || d.patient_nationality || '';\nconst deathDate = d.deceased_death_date || '';\nconst medicalReport = d.medical_report_url || '';\n\n// تفضيلات النائب\nconst proxyPreference = d.proxy_preference || 'any';\nconst preferredDate = d.preferred_date || '';\nconst specialRequests = d.special_requests || d.notes || '';\n\n// توليد request_id فريد\nconst timestamp = Date.now().toString(36).toUpperCase();\nconst random = Math.random().toString(36).slice(2,5).toUpperCase();\nconst prefix = isHajj ? 'HJ' : 'UM';\nconst request_id = `${prefix}-${category.toUpperCase()}-${timestamp}-${random}`;\n\n// تحديد الأولوية حسب النوع\nlet priorityScore = 60;\nif (category === 'deceased') {\n  priorityScore = 85;\n} else if (category === 'patient') {\n  priorityScore = 80;\n} else if (category === 'disabled') {\n  priorityScore = 75;\n}\n\nreturn [{ json: {\n  request_id,\n  request_type: requestType,\n  is_hajj: isHajj,\n  category: category, // deceased, patient, disabled\n  \n  // بيانات مقدم الطلب\n  requester_name: requesterName,\n  requester_relation: requesterRelation,\n  requester_phone: requesterPhone.startsWith('+') ? requesterPhone : '+966' + requesterPhone.replace(/^0/,''),\n  requester_email: requesterEmail,\n  requester_id_number: requesterId,\n  \n  // بيانات المستفيد (المتوفي/المريض/العاجز)\n  beneficiary_name: beneficiaryName,\n  beneficiary_nationality: beneficiaryNationality,\n  death_date: deathDate,\n  medical_report_url: medicalReport,\n  \n  // تفضيلات الخدمة\n  proxy_preference: proxyPreference,\n  preferred_date: preferredDate,\n  special_requests: specialRequests,\n  \n  // مصدر الطلب\n  source: d.source || 'Website',\n  platform: d.platform || 'Website',\n  lead_id: d.lead_id || request_id,\n  \n  // حالة الطلب\n  status: 'new',\n  eligibility_status: 'pending',\n  docs_status: 'pending',\n  proxy_assigned: false,\n  \n  // نقاط الأولوية\n  priority_score: priorityScore,\n  \n  // معلومات النظام\n  created_at: new Date().toISOString(),\n  flow_origin: 'HajjUmrah_F1_Proxy_Request',\n  service_type: isHajj ? 'hajj_proxy' : 'umrah_proxy',\n}}];\n"
      }
    },
    {
      "id": "hu-code-002",
      "name": "Code – Validate Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 100],
      "parameters": {
        "jsCode": "\n// HajjUmrah – F1 – Validate Proxy Request\nconst d = $input.first().json;\nconst errors = [];\n\n// التحقق من رقم الهاتف\nif (!d.requester_phone || d.requester_phone.length < 10) {\n  errors.push('رقم الهاتف مفقود أو غير صالح');\n}\n\n// التحقق من اسم مقدم الطلب\nif (!d.requester_name || d.requester_name.length < 2) {\n  errors.push('اسم مقدم الطلب مفقود');\n}\n\n// التحقق من هوية مقدم الطلب\nif (!d.requester_id_number || d.requester_id_number.length < 10) {\n  errors.push('رقم الهوية/الإقامة لمقدم الطلب مفقود');\n}\n\n// التحقق من اسم المستفيد\nif (!d.beneficiary_name || d.beneficiary_name.length < 2) {\n  errors.push('اسم المتوفي/المريض/العاجز مفقود');\n}\n\n// تحقق خاص بالمتوفي\nif (d.category === 'deceased' && !d.death_date) {\n  errors.push('تاريخ الوفاة مطلوب للطلبات نيابة عن متوفي');\n}\n\n// تحقق خاص بالمريض والعاجز\nif ((d.category === 'patient' || d.category === 'disabled') && !d.medical_report_url) {\n  // تحذير وليس خطأ Fatal\n  // errors.push('التقرير الطبي مفضل للمرضى والعاجزين');\n}\n\nconst valid = errors.length === 0;\nreturn [{ json: { ...d, is_valid: valid, validation_errors: errors.join(' | ') }}];\n"
      }
